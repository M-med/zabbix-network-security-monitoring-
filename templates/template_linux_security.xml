                    <yaxisside>0</yaxisside>
                    <calc_fnc>AVG</calc_fnc>
                    <type>0</type>
                    <item>
                        <host>Template_Linux_Security</host>
                        <key>system.cpu.load[percpu,avg1]</key>
                    </item>
                </graph_item>
            </graph_items>
        </graph>
