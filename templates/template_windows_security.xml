    <templates>
        <template>
            <template>Template_Windows_Security</template>
            <name>Windows Security Monitoring</name>
            <description>Template for monitoring Windows security events, services, and system integrity.</description>
            <groups>
                <group>
                    <name>Templates/Security</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>Security</name>
                </application>
                <application>
                    <name>System</name>
                </application>
                <application>
                    <name>Network</name>
                </application>
            </applications>
            <items>
                <!-- CPU Utilization -->
                <item>
                    <name>CPU utilization</name>
                    <type>ZABBIX_PASSIVE</type>
                    <snmp_community/>
                    <snmp_oid/>
                    <key>perf_counter["\Processor(_Total)\% Processor Time"]</key>
                    <delay>1m</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>FLOAT</value_type>
                    <allowed_hosts/>
                    <units>%</units>
                    <params/>
                    <ipmi_sensor/>
                    <authtype>NONE</authtype>
                    <username/>
                    <password/>
                    <publickey/>
                    <privatekey/>
                    <port/>
                    <description>CPU utilization percentage</description>
                    <inventory_link>0</inventory_link>
                    <applications>
                        <application>
                            <name>System</name>
                        </application>
                    </applications>
                    <valuemap/>
                    <logtimefmt/>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <params>0.01</params>
                        </step>
                    </preprocessing>
                </item>
                <!-- Memory Utilization -->
                <item>
                    <name>Memory utilization</name>
                    <type>ZABBIX_PASSIVE</type>
                    <snmp_community/>
                    <snmp_oid/>
                    <key>perf_counter["\Memory\% Committed Bytes In Use"]</key>
                    <delay>1m</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>FLOAT</value_type>
                    <allowed_hosts/>
                    <units>%</units>
                    <params/>
                    <ipmi_sensor/>
                    <authtype>NONE</authtype>
                    <username/>
                    <password/>
                    <publickey/>
                    <privatekey/>
                    <port/>
                    <description>Memory utilization percentage</description>
                    <inventory_link>0</inventory_link>
                    <applications>
                        <application>
                            <name>System</name>
                        </application>
                    </applications>
                    <valuemap/>
                    <logtimefmt/>
                </item>
                <!-- Disk Space C: -->
                <item>
                    <name>Disk space C: (used)</name>
                    <type>ZABBIX_PASSIVE</type>
                    <snmp_community/>
                    <snmp_oid/>
                    <key>vfs.fs.size[C:,used]</key>
