    <triggers>
        <!-- CPU Utilization Trigger -->
        <trigger>
            <expression>avg(/Template_Windows_Security/perf_counter["\Processor(_Total)\% Processor Time"],5m)&gt;90</expression>
            <name>High CPU utilization on {HOST.NAME}</name>
            <priority>WARNING</priority>
            <description>CPU utilization is above 90% for 5 minutes</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Memory Utilization Trigger -->
        <trigger>
            <expression>avg(/Template_Windows_Security/perf_counter["\Memory\% Committed Bytes In Use"],5m)&gt;90</expression>
            <name>High memory utilization on {HOST.NAME}</name>
            <priority>WARNING</priority>
            <description>Memory utilization is above 90% for 5 minutes</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Disk Space Trigger -->
        <trigger>
            <expression>last(/Template_Windows_Security/vfs.fs.size[C:,pused])&gt;90</expression>
            <name>Disk space critically low on {HOST.NAME} (C:)</name>
            <priority>AVERAGE</priority>
            <description>Disk space on C: is above 90% usage</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Network Interface Down Trigger -->
        <trigger>
            <expression>last(/Template_Windows_Security/net.if.status[Ethernet])=2</expression>
            <name>Network interface down on {HOST.NAME}</name>
            <priority>AVERAGE</priority>
            <description>Network interface Ethernet is down</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Windows Defender Service Down Trigger -->
        <trigger>
            <expression>last(/Template_Windows_Security/service.info["WinDefend",state])&lt;&gt;0</expression>
            <name>Windows Defender service is not running on {HOST.NAME}</name>
            <priority>HIGH</priority>
            <description>Windows Defender service is not running</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Windows Firewall Service Down Trigger -->
        <trigger>
            <expression>last(/Template_Windows_Security/service.info["MpsSvc",state])&lt;&gt;0</expression>
            <name>Windows Firewall service is not running on {HOST.NAME}</name>
            <priority>HIGH</priority>
            <description>Windows Firewall service is not running</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Failed Login Attempts Trigger -->
        <trigger>
            <expression>count(/Template_Windows_Security/eventlog[Security,,,4625,,skip],5m)&gt;5</expression>
            <name>Multiple failed login attempts on {HOST.NAME}</name>
            <priority>HIGH</priority>
            <description>More than 5 failed login attempts in 5 minutes</description>
            <status>ENABLED</status>
        </trigger>
        <!-- Zabbix Agent Unavailable Trigger -->
        <trigger>
            <expression>last(/Template_Windows_Security/zabbix[host,agent,available])=0</expression>
            <name>Zabbix agent is not available on {HOST.NAME}</name>
            <priority>AVERAGE</priority>
            <description>Zabbix agent is not available</description>
            <status>ENABLED</status>
        </trigger>
    </triggers>
